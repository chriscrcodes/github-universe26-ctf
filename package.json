{
  "name": "github-universe26-ctf",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Universe purple-team workshop",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "app"
  ],
  "scripts": {
    "start": "npm --workspace app start",
    "workshop:app": "node scripts/start-workshop-app.mjs",
    "workshop:restart": "node scripts/start-workshop-app.mjs --restart",
    "register": "npm --workspace app run register",
    "approve": "npm --workspace app run approve --",
    "verify": "npm --workspace app run verify",
    "codeql:review": "npm --workspace app run codeql:review --",
    "delivery": "npm --workspace app run delivery",
    "regressions": "npm --workspace app run regressions",
    "reset": "npm --workspace app run reset",
    "phase": "npm --workspace app run phase --",
    "workshop:start": "node scripts/workshop-start.mjs",
    "squad:install-workshop-team": "node scripts/install-workshop-squad.mjs",
    "test": "node --test test/*.test.mjs app/test/*.test.js",
    "test:integration": "node --test test/*.integration.mjs"
  }
}
